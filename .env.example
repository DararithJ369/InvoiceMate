# =========================================
# InvoiceMate Configuration Template
# =========================================

# Telegram Bot Token (obtain from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider Selection: "gemini" | "claude" | "rule_engine"
LLM_PROVIDER=gemini

# Bakong Account ID for KHQR Payment Receiving (e.g., merchant@bakong or your_username@aba)
BAKONG_ACCOUNT_ID=invoicemate@bakong

# Bakong Webhook HMAC Secret (used to verify incoming payment callbacks from Bakong Open API)
BAKONG_WEBHOOK_SECRET=your_bakong_webhook_secret_here

# Database Connection (SQLite default for local dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./invoicemate.db
SQL_ECHO=0

# Application Defaults
DEFAULT_CURRENCY=USD
INVOICE_PREFIX=INV-
INVOICE_PADDING=6
STORAGE_DIR=./storage/invoices

# Server & Public Access URL
HOST=0.0.0.0
PORT=8000
BASE_URL=http://localhost:8000

# Bakong Open API (Inquiry & Remote Status Checks)
BAKONG_API_URL=https://api-bakong.nbc.gov.kh/v1
BAKONG_API_TOKEN=your_bakong_open_api_token_here

# Anthropic Claude API Key (optional fallback provider)
ANTHROPIC_API_KEY=your_claude_api_key_here
